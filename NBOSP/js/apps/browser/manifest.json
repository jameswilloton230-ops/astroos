{
  "id": "com.nbosp.browser",
  "name": "Browser",
  "version": "3.0.2",
  "description": "Browse websites and manage your web browsing experience in NovaByte OS.",
  "author": "DirazCoder",
  "entry": "index.html",
  "unrestrictedEntry": "app.js",
  "icon": "globe",
  "type": "blank",
  "defaultSize": [900, 600],
  "minSize": [500, 350],
  "resizable": true,
  "frame": true,
  "categories": ["network", "utilities"],
  "system": true,
  "transparent": true,
  "allowNestedWebview": true,
  "sandbox": {
    "allowScripts": true,
    "allowForms": true,
    "allowPopups": true
  }
}