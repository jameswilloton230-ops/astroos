{
  "id": "com.nbosp.gallery",
  "name": "Gallery",
  "version": "3.0.2",
  "author": "DirazCoder",
  "description": "Browse and view images stored on your device.",
  "entry": "index.html",
  "unrestrictedEntry": "app.js",
  "icon": "image",
  "type": "blank",
  "defaultSize": [
    840,
    580
  ],
  "minSize": [
    500,
    360
  ],
  "resizable": true,
  "frame": true,
  "categories": [
    "media",
    "utilities"
  ],
  "system": true,
  "handles": {
    "protocols": [],
    "extensions": [
      ".jpg",
      ".jpeg",
      ".png",
      ".gif",
      ".webp",
      ".bmp",
      ".svg",
      ".avif",
      ".tiff"
    ]
  },
  "transparent": true
}
