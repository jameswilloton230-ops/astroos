#!/bin/sh

# --- GL / WebGL bring-up debugging ------------------------------------------
# Controlled at runtime via /boot/nbosp-debug — no rebuild needed.
#
# To turn debug ON:   touch /boot/nbosp-debug    (or set NBOSP_GL_DEBUG=1 in
#                     the kernel cmdline / init env)
# To turn debug OFF:  rm /boot/nbosp-debug
#
# What debug mode does:
#   * cage logs at WLR_DEBUG (CAGE_DEBUG, via patches/cage/0001-*.patch)
#   * cage starts a wrapper instead of Xwayland that runs it with -verbose 10,
#     LD_DEBUG=libs and (if installed) strace of failing file/ioctl calls
#   * Mesa EGL / Chromium GPU-process logging is turned up
#   * ~30s after boot a dump of the whole graphics state goes to
#     /home/nbosp/nbosp-gl-debug.log, the serial console and nbosp-kiosk.log
# Resolve NBOSP_GL_DEBUG. Priority: env (already set) > kernel cmdline > off.
if [ -z "$NBOSP_GL_DEBUG" ]; then
  _cmdline="$(cat /proc/cmdline 2>/dev/null)"
  case "$_cmdline" in
    *NBOSP_GL_DEBUG=1*) NBOSP_GL_DEBUG=1 ;;
    *NBOSP_GL_DEBUG=0*) NBOSP_GL_DEBUG=0 ;;
    *)                  NBOSP_GL_DEBUG=0 ;;
  esac
  unset _cmdline
fi
if [ "$NBOSP_GL_DEBUG" = 1 ]; then
  export LIBGL_DEBUG=verbose
fi
GL_DEBUG_LOG=/home/nbosp/nbosp-gl-debug.log

# Recovery is entered from the GRUB entry (nbosp.recovery=1 on the kernel
# cmdline) or from a one-shot request file the desktop drops before it
# restarts the machine (Settings > Recovery, or the boot watchdog after
# repeated failed starts). The request file is consumed here so it can never
# trap the machine in recovery twice.
RECOVERY_REQUEST=/home/nbosp/.config/novabyte/recovery-request
nbosp_recovery_requested() {
  [ -n "$NBOSP_RECOVERY_DONE" ] && return 1
  [ -x /usr/sbin/nbosp-recovery ] || return 1
  if [ -f "$RECOVERY_REQUEST" ]; then
    rm -f "$RECOVERY_REQUEST"
    return 0
  fi
  case "$(cat /proc/cmdline 2>/dev/null)" in
    *nbosp.recovery=1*) return 0 ;;
  esac
  return 1
}

nbosp_gl_debug_setup() {
  gl_debug_env=""
  chromium_gl_debug=""
  [ "$NBOSP_GL_DEBUG" = 1 ] || return 0

  mkdir -p /run/nbosp-debug-bin
  cat > /run/nbosp-debug-bin/Xwayland <<'XWRAP'
#!/bin/sh
# Installed by S99nbosp (NBOSP_GL_DEBUG). wlroots runs this instead of Xwayland.
LOG=/home/nbosp/xwayland-debug.log
echo "=== $(date) Xwayland wrapper: $*" >> "$LOG"
export LD_DEBUG=libs LD_DEBUG_OUTPUT=/home/nbosp/xwayland-ld
# strace is opt-in (NBOSP_GL_STRACE=1). As the parent of Xwayland it can break
# cage's startup handshake, which killed the first debug boot.
if [ "@STRACE@" = 1 ] && [ -x /usr/bin/strace ]; then
  exec /usr/bin/strace -f -qq -Z -s 256 -o /home/nbosp/xwayland.strace \
    -e trace=file,ioctl,connect,mmap \
    /usr/bin/Xwayland "$@" -verbose 10 >> "$LOG" 2>&1
fi
exec /usr/bin/Xwayland "$@" -verbose 10 >> "$LOG" 2>&1
XWRAP
  sed -i "s/@STRACE@/${NBOSP_GL_STRACE:-0}/" /run/nbosp-debug-bin/Xwayland
  chmod 0755 /run/nbosp-debug-bin/Xwayland
  rm -f /home/nbosp/xwayland-debug.log /home/nbosp/xwayland-ld.* /home/nbosp/xwayland.strace
  : > /home/nbosp/xwayland-debug.log
  chown nbosp:nbosp /home/nbosp/xwayland-debug.log 2>/dev/null || true

  # WLR_XWAYLAND is honoured by wlroots; the PATH prefix is a fallback in case
  # it execs plain "Xwayland". Values must not contain quotes or dollar signs.
  gl_debug_env="CAGE_DEBUG=1 EGL_LOG_LEVEL=debug MESA_DEBUG=1"
  # The Xwayland wrapper is opt-in (NBOSP_GL_XWRAP=1). In the last two debug boots
  # cage's Xwayland died within 10-90ms whenever it was routed through it, so the
  # default path leaves Xwayland alone and probes a second instance in the dump.
  if [ "${NBOSP_GL_XWRAP:-0}" = 1 ]; then
    gl_debug_env="PATH=/run/nbosp-debug-bin:/usr/local/bin:/usr/bin:/bin:/usr/local/sbin:/usr/sbin:/sbin WLR_XWAYLAND=/run/nbosp-debug-bin/Xwayland $gl_debug_env"
  fi
  chromium_gl_debug="--enable-gpu-service-logging --vmodule=gl_display=3,gl_context=3,gl_surface=3,gl_ozone_egl=3,egl_util=3,gl_utils=3,gpu_init=3,gpu_info_collector=3,gpu_service_impl=3,viz_main_impl=3,angle_platform_impl=3,gpu_feature_info=2"
}

nbosp_gl_find_pid() {
  for d in /proc/[0-9]*; do
    if [ "$(cat "$d/comm" 2>/dev/null)" = "$1" ]; then
      echo "${d#/proc/}"
      return 0
    fi
  done
  return 1
}

nbosp_gl_sec() {
  echo
  echo "===== $* ====="
}

nbosp_gl_proc_report() {
  name="$1"
  pid="$(nbosp_gl_find_pid "$name")" || {
    nbosp_gl_sec "$name"
    echo "$name is NOT running"
    return 0
  }
  nbosp_gl_sec "$name pid=$pid cmdline"
  tr '\0' ' ' < "/proc/$pid/cmdline"
  echo
  nbosp_gl_sec "$name environment (graphics-relevant)"
  tr '\0' '\n' < "/proc/$pid/environ" \
    | grep -E '^(LD_|LIBGL|EGL|MESA|WLR_|XDG_|WAYLAND|DISPLAY|PATH|GBM|LIBSEAT|CAGE)' || true
  nbosp_gl_sec "$name mapped libraries (graphics-relevant)"
  awk '{ print $6 }' "/proc/$pid/maps" | sort -u \
    | grep -i -E 'EGL|GLX|libGL|gbm|epoxy|dri|glvnd|vulkan|swiftshader|libdrm|wayland|pixman' || true
  nbosp_gl_sec "$name DRM / socket fds"
  ls -l "/proc/$pid/fd" 2>&1 | grep -E 'dri|socket' | head -20 || true
}

nbosp_gl_debug_dump() {
  out="$GL_DEBUG_LOG"
  : > "$out"

  # cage starts Xwayland lazily when Chromium connects; wait up to ~90s for it.
  i=0
  while [ "$i" -lt 45 ]; do
    nbosp_gl_find_pid Xwayland >/dev/null && break
    sleep 2
    i=$((i + 1))
  done
  sleep 8   # let glamor init finish and Chromium's GPU process retry

  # Probe: a second Xwayland on :7 against the running cage, with full verbosity.
  # Its log should say why glamor falls back, without touching cage's own Xwayland.
  rm -f /home/nbosp/xwayland-probe.log
  su -s /bin/sh nbosp -c 'export HOME=/home/nbosp XDG_RUNTIME_DIR=/run/user/1000 WAYLAND_DISPLAY=wayland-0 LIBSEAT_BACKEND=seatd EGL_LOG_LEVEL=debug MESA_DEBUG=1; /usr/bin/Xwayland :7 -rootless -verbose 10 -noreset > /home/nbosp/xwayland-probe.log 2>&1 & p=$!; sleep 6; kill $p 2>/dev/null; sleep 1; kill -9 $p 2>/dev/null; echo "probe exit handled" >> /home/nbosp/xwayland-probe.log'
  # Same probe under strace (failed calls only) to catch the lookup glamor trips on.
  rm -f /home/nbosp/xwayland-probe.strace
  if [ -x /usr/bin/strace ]; then
    su -s /bin/sh nbosp -c 'export HOME=/home/nbosp XDG_RUNTIME_DIR=/run/user/1000 WAYLAND_DISPLAY=wayland-0 LIBSEAT_BACKEND=seatd EGL_LOG_LEVEL=debug MESA_DEBUG=1; /usr/bin/strace -f -qq -Z -s 200 -o /home/nbosp/xwayland-probe.strace -e trace=file,ioctl,connect /usr/bin/Xwayland :8 -rootless -verbose 10 -noreset > /home/nbosp/xwayland-probe-strace.log 2>&1 & p=$!; sleep 8; kill $p 2>/dev/null; sleep 1; kill -9 $p 2>/dev/null' </dev/null >/dev/null 2>&1
  fi </dev/null >/dev/null 2>&1

  {
    echo "===== NBOSP GL DEBUG DUMP $(date) ====="
    nbosp_gl_sec "versions"
    uname -a
    /usr/bin/cage -v 2>&1 | head -2
    /usr/bin/Xwayland -version 2>&1 | head -4

    nbosp_gl_sec "DRM nodes"
    ls -la /dev/dri 2>&1
    for card in /sys/class/drm/card[0-9]*; do
      [ -e "$card/device/driver" ] || continue
      echo "$card -> $(basename "$(readlink -f "$card/device/driver")")"
    done

    nbosp_gl_sec "dmesg (drm/vmwgfx)"
    dmesg 2>&1 | grep -i -E 'vmwgfx|drm|ttm|svga' | tail -40

    nbosp_gl_sec "graphics libraries in /usr/lib"
    ls -l /usr/lib 2>&1 | grep -i -E 'libEGL|libGL|libgbm|libepoxy|libglapi|libdrm|libwayland|libxshmfence|vulkan'
    nbosp_gl_sec "/usr/lib/dri"
    ls -la /usr/lib/dri 2>&1
    nbosp_gl_sec "libglvnd EGL vendor files"
    ls -la /usr/share/glvnd/egl_vendor.d 2>&1
    for f in /usr/share/glvnd/egl_vendor.d/*; do
      [ -f "$f" ] && { echo "-- $f"; cat "$f"; }
    done
    nbosp_gl_sec "Vulkan ICDs"
    ls -la /usr/share/vulkan/icd.d /etc/vulkan/icd.d 2>&1

    nbosp_gl_sec "NW.js runtime layout"
    ls -la /opt/nbosp 2>&1 | head -60
    ls -la /opt/nbosp/lib /opt/nbosp/swiftshader 2>&1 | head -60

    nbosp_gl_proc_report cage
    nbosp_gl_proc_report Xwayland

    if [ -x /usr/bin/wayland-info ]; then
      nbosp_gl_sec "wayland-info (compositor globals, dmabuf/drm)"
      su -s /bin/sh nbosp -c 'export XDG_RUNTIME_DIR=/run/user/1000 WAYLAND_DISPLAY=wayland-0; wayland-info 2>&1' \
        | grep -i -E 'interface|dmabuf|wl_drm|format|device' | head -80
    fi
    if [ -x /usr/bin/eglinfo ]; then
      nbosp_gl_sec "eglinfo"
      su -s /bin/sh nbosp -c 'export XDG_RUNTIME_DIR=/run/user/1000 WAYLAND_DISPLAY=wayland-0 DISPLAY=:0; eglinfo 2>&1' | head -250
    fi
    if [ -x /usr/bin/glxinfo ]; then
      nbosp_gl_sec "glxinfo -B (against XWayland :0)"
      su -s /bin/sh nbosp -c 'export XDG_RUNTIME_DIR=/run/user/1000 WAYLAND_DISPLAY=wayland-0 DISPLAY=:0; glxinfo -B 2>&1' | head -60
    fi

    nbosp_gl_sec "xwayland-probe.log ($(wc -l < /home/nbosp/xwayland-probe.log 2>/dev/null) lines): glamor / egl / gbm / dmabuf lines"
    grep -n -i -E 'glamor|egl|gbm|dmabuf|drm|dri3|glx|epoxy|wl_drm|modifier|fail|error' /home/nbosp/xwayland-probe.log 2>&1 | head -120
    nbosp_gl_sec "xwayland-probe.log: head"
    head -40 /home/nbosp/xwayland-probe.log 2>&1
    nbosp_gl_sec "xwayland-probe-strace.log (stderr of the strace'd probe)"
    head -40 /home/nbosp/xwayland-probe-strace.log 2>&1
    nbosp_gl_sec "xwayland-probe.strace: failed calls touching dri/drm/gbm/egl/mesa/glvnd"
    grep -i -E 'dri|drm|gbm|egl|mesa|glvnd|render|wayland' /home/nbosp/xwayland-probe.strace 2>&1 | tail -60
    nbosp_gl_sec "xwayland-debug.log: glamor / egl / gbm / dmabuf lines"
    grep -n -i -E 'glamor|egl|gbm|dmabuf|drm|dri3|glx|epoxy|wl_drm|modifier' /home/nbosp/xwayland-debug.log 2>&1 | head -120
    nbosp_gl_sec "xwayland-debug.log: tail"
    tail -40 /home/nbosp/xwayland-debug.log 2>&1
    nbosp_gl_sec "xwayland.strace: failed DRM/EGL/GBM/ioctl calls"
    grep -E 'dri|gbm|EGL|egl|glvnd|vulkan|drm|ioctl' /home/nbosp/xwayland.strace 2>&1 | head -150
    nbosp_gl_sec "xwayland LD_DEBUG: GL-related lines"
    grep -h -i -E 'error|cannot|not found|libEGL|libGL\.so|libgbm|epoxy|glvnd|/dri/' /home/nbosp/xwayland-ld.* 2>&1 | head -120

    echo
    echo "===== END NBOSP GL DEBUG DUMP ====="
  } >> "$out" 2>&1

  chown nbosp:nbosp "$out" 2>/dev/null || true
  cat "$out" > /dev/ttyS0 2>/dev/null || true
  cat "$out" >> /home/nbosp/nbosp-kiosk.log 2>/dev/null || true
}

case "$1" in
  start)
    if nbosp_recovery_requested; then
      # Menu runs on VT1 in place of the kiosk. -w keeps it attached to the
      # VT; start-stop-daemon keeps init from waiting on it.
      start-stop-daemon --start --background --exec /usr/bin/openvt -- \
        -f -s -w -c 1 -- /usr/sbin/nbosp-recovery
      exit 0
    fi
    app="/opt/nbosp/NovaByte"
    if [ ! -x "$app" ]; then
      echo "NBOSP kiosk app is missing or not executable: $app" >&2
      exit 1
    fi
    if [ ! -x /usr/bin/cage ]; then
      echo "NBOSP kiosk: Cage is missing" >&2
      exit 1
    fi

    runtime_dir="/run/user/1000"
    mkdir -p "$runtime_dir"
    chown nbosp:nbosp "$runtime_dir"
    chmod 0700 "$runtime_dir"
    mkdir -p /home/nbosp/.config/novabyte
    mkdir -p /home/nbosp/.config/novabyte/runtime
    chown nbosp:nbosp /home/nbosp/.config /home/nbosp/.config/novabyte /home/nbosp/.config/novabyte/runtime

    attempt=0
    while [ "$attempt" -lt 30 ]; do
      seatd_ready=false
      drm_ready=false
      [ -S /run/seatd.sock ] && seatd_ready=true
      [ -e /dev/dri/card0 ] && drm_ready=true
      [ "$seatd_ready" = true ] && [ "$drm_ready" = true ] && break
      sleep 1
      attempt=$((attempt + 1))
    done

    if [ ! -S /run/seatd.sock ]; then
      echo "NBOSP kiosk: seatd socket missing at /run/seatd.sock" >&2
      exit 1
    fi
    if [ ! -e /dev/dri/card0 ]; then
      echo "NBOSP kiosk: VMware DRM device missing; available DRM devices:" >&2
      ls -la /dev/dri >&2 2>/dev/null || echo "  /dev/dri does not exist" >&2
      exit 1
    fi
    if ! grep -q '^render:' /etc/group; then
      echo "NBOSP kiosk: the DRM render group is missing from /etc/group." >&2
      exit 1
    fi
    vmwgfx_bound=false
    for card in /sys/class/drm/card[0-9]*; do
      [ -e "$card/device/driver" ] || continue
      driver="$(basename "$(readlink -f "$card/device/driver")")"
      if [ "$driver" = vmwgfx ]; then
        vmwgfx_bound=true
        break
      fi
    done
    if [ "$vmwgfx_bound" != true ]; then
      echo "NBOSP kiosk: VMware vmwgfx kernel driver is not bound to a DRM device." >&2
      ls -la /sys/class/drm >&2
      exit 1
    fi
    echo "NBOSP kiosk: VMware vmwgfx kernel driver is active."
    render_device=""
    for device in /dev/dri/renderD*; do
      [ -c "$device" ] || continue
      if su -s /bin/sh nbosp -c "test -r '$device' && test -w '$device'"; then
        render_device="$device"
        break
      fi
    done
    if [ -z "$render_device" ]; then
      echo "NBOSP kiosk: nbosp cannot access a DRM render node; hardware acceleration would fail." >&2
      ls -la /dev/dri >&2
      id nbosp >&2
      exit 1
    fi
    if [ ! -x /usr/bin/dbus-run-session ]; then
      echo "NBOSP kiosk: dbus-run-session is missing" >&2
      exit 1
    fi
    if ! command -v amixer >/dev/null 2>&1; then
      echo "NBOSP audio: amixer is missing from the image" >&2
      exit 1
    fi
    if grep -Eq '^[[:space:]]*[0-9]+[[:space:]]' /proc/asound/cards 2>/dev/null; then
      mixer_controls=0
      for control in Master PCM Front Speaker Headphone Line Surround Center LFE; do
        if amixer -q -c 0 sset "$control" 80% unmute >/dev/null 2>&1; then
          mixer_controls=$((mixer_controls + 1))
        fi
      done
      if [ "$mixer_controls" -gt 0 ]; then
        echo "NBOSP audio: enabled $mixer_controls playback mixer control(s)."
      else
        echo "NBOSP audio: no supported playback mixer controls found on card 0." >&2
        amixer -c 0 scontrols >&2 || true
      fi
    else
      echo "NBOSP audio: no ALSA sound card detected; check the VMware sound device connection" >&2
    fi
    app_data_dir="/opt/nbosp/package.nw"
    if [ ! -d "$app_data_dir" ]; then
      echo "NBOSP kiosk: app data directory is missing: $app_data_dir" >&2
      exit 1
    fi
    if ! chown nbosp:nbosp /opt/nbosp; then
      echo "NBOSP kiosk: cannot prepare writable runtime state under /opt/nbosp" >&2
      exit 1
    fi
    if [ ! -f /opt/nbosp/lib/libffmpeg.so ]; then
      echo "NBOSP kiosk: NW.js runtime library is missing: /opt/nbosp/lib/libffmpeg.so" >&2
      exit 1
    fi
    keyboard_layout=us
    keyboard_layout_file=/home/nbosp/.config/novabyte/keyboard-layout
    if [ -f "$keyboard_layout_file" ]; then
      keyboard_layout="$(cat "$keyboard_layout_file")"
    fi
    case "$keyboard_layout" in
      us|gb|ca|au|de|fr|be|es|it|pt|br|nl|se|no|dk|fi|pl|tr|ru|ua|jp) ;;
      *)
        echo "NBOSP kiosk: invalid saved keyboard layout '$keyboard_layout'; using us" >&2
        keyboard_layout=us
        ;;
    esac
    nbosp_gl_debug_setup
    cat > /run/nbosp-kiosk-session.sh <<SESSION
#!/bin/sh
export LD_LIBRARY_PATH=/opt/nbosp/lib:/opt/nbosp
[ -x /usr/bin/nbosp-vmusr ] && /usr/bin/nbosp-vmusr &
exec /opt/nbosp/NovaByte --enable-features=UseOzonePlatform \
  --ozone-platform=x11 --use-gl=angle --use-angle=gl \
  --disable-features=Vulkan \
  $chromium_gl_debug \
  --ignore-gpu-blocklist --enable-gpu-rasterization --enable-zero-copy \
  --allow-insecure-localhost --enable-logging=stderr
SESSION
    chmod 0755 /run/nbosp-kiosk-session.sh

    if [ ! -d /run/nbosp-wayland ]; then
      mkdir -m 2710 /run/nbosp-wayland
    fi
    if ! chown nbosp:nbosp-wayland /run/nbosp-wayland \
      || ! chmod 2710 /run/nbosp-wayland; then
      echo "NBOSP kiosk: cannot prepare the private Wayland runtime directory." >&2
      exit 1
    fi

    cat > /run/nbosp-compositor-session.sh <<'SESSION'
#!/bin/sh
umask 0007
exec /usr/bin/cage -- /run/nbosp-kiosk-session.sh
SESSION
    chmod 0755 /run/nbosp-compositor-session.sh

    start-stop-daemon --start --background --make-pidfile \
      --pidfile /run/nbosp-kiosk.pid --exec /usr/bin/openvt -- \
      -f -s -w -c 1 -- /bin/sh -c \
      'n=0; while [ -f /run/nbosp-kiosk.pid ] && [ "$n" -lt 5 ]; do su -s /bin/sh nbosp -c "export HOME=/home/nbosp NODE_ENV=production XDG_RUNTIME_DIR=/run/nbosp-wayland LIBSEAT_BACKEND=seatd NODE_BIN_PATH=/opt/nbosp/NovaByte NBOSP_DATA_DIR=/home/nbosp/.config/novabyte/runtime LD_LIBRARY_PATH=/opt/nbosp/lib:/opt/nbosp XCURSOR_THEME=whiteglass XCURSOR_SIZE=32 XCURSOR_PATH=/usr/share/icons:/usr/share/pixmaps WLR_NO_HARDWARE_CURSORS=1 '"$gl_debug_env"' XDG_CURRENT_DESKTOP=cage XDG_SESSION_TYPE=wayland GDK_BACKEND=wayland XKB_DEFAULT_LAYOUT='"$keyboard_layout"'; unset DBUS_SESSION_BUS_ADDRESS; exec /usr/bin/dbus-run-session -- /run/nbosp-compositor-session.sh" 2>&1 | tee -a /home/nbosp/nbosp-kiosk.log /dev/ttyS0 >/dev/null; n=$((n+1)); echo "NBOSP kiosk: session exited, restart $n of 5 allowed" >/dev/ttyS0 2>/dev/null; sleep 2; done'

    if [ "$NBOSP_GL_DEBUG" = 1 ]; then
      nbosp_gl_debug_dump </dev/null >/dev/null 2>&1 &
    fi
    ;;
  stop)
    if [ -f /run/nbosp-kiosk.pid ]; then
      kill "$(cat /run/nbosp-kiosk.pid)" 2>/dev/null || true
      rm -f /run/nbosp-kiosk.pid
    fi
    ;;
  restart|reload)
    "$0" stop
    "$0" start
    ;;
  *)
    echo "Usage: $0 {start|stop|restart}" >&2
    exit 1
    ;;
esac

exit 0
