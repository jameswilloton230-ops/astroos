**/node_modules/
**/.env
**/*.key
**/*.pem
**/cert.crt
**/cert.key
**/.update-backups/
**/.update-keys/
**/server.log
/build
/novabyte-v3-build
/.build-stage
**/.cache/
**/.dist/
/astro-os/cache/
/astro-os/dist/
**/ca.crt
**/ca.trusted
/astro-os/data/
/astro-os/js/purify.min.js
/astro-os/.zcode
/astro-os/.kilo
/astro-os/.vs
/astro-os/graphify-out
/astro-os/.graphifyignore
server.log
.wrangler

# prebuilt app packages — source lives in astro-os/js/apps/<name>/, build with repackage.js
/astro-os/js/apps/*.novaapp

# astro-os/keys/ holds the AOSP-style PUBLIC test signing key plus its README.
# Everything else there (release keys, rotation candidates) stays ignored —
# only the deliberately-public test key pair is committed. See keys/README.md.
/astro-os/keys/*
!/astro-os/keys/test-system-key.json
!/astro-os/keys/README.md
