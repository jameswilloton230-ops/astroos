{
  "name": "astro-server",
  "version": "1.0.0",
  "description": "Astro Server",
  "main": "client.js",
  "permissions": [
    "downloads"
  ],
  "scripts": {
    "start": "nw .",
    "prestart": "node scripts/bootstrap.js && node scripts/build-apps-on-start.js",
    "predev": "node scripts/bootstrap.js && node scripts/build-apps-on-start.js",
    "dev": "nw . --enable-logging=stderr --v=1",
    "test": "npx vitest run --reporter=verbose",
    "test:integration": "node tests/integration/run-all.js",
    "clean": "node -e \"const {exec}=require('child_process');exec(process.platform==='win32'?'taskkill /F /IM nw.exe':'pkill -x nw; pkill -x nwjs; exit 0',()=>console.log('\\u2714 Cleared.'))\""
  },
  "window": {
    "title": "AstroOS",
    "width": 1280,
    "height": 720,
    "min_width": 800,
    "min_height": 500,
    "frame": true,
    "icon": "assets/icon.png",
    "icons": {
      "128": "assets/icon.png"
    },
    "dev_tools": true,
    "chromium-args": "--no-first-run --disable-features=Vulkan,CalculateNativeWinOcclusion,Translate,AutofillServerCommunication --disable-zero-copy --js-flags=\"--expose-gc --max-old-space-size=512\" --ignore-gpu-blocklist --disable-background-timer-throttling --disable-renderer-backgrounding --user-data-dir=./nwjs-data --remote-debugging-port=9222 --auto-open-devtools-for-tabs --disable-web-security --allow-file-access-from-files --hide-crash-restore-bubble --deny-permission-prompts --password-store=basic --no-default-browser-check --disable-component-update"
  },
  "node-remote": "https://localhost:*",
  "keywords": [
    "Server"
  ],
  "author": "jameswilloton230-ops",
  "license": "MIT",
  "dependencies": {
    "@noble/ciphers": "^2.4.0",
    "@noble/hashes": "^2.4.0",
    "@noble/post-quantum": "^0.7.1",
    "@peculiar/x509": "^3.1.0",
    "better-sqlite3": "^13.1.1",
    "better-sqlite3-session-store": "^0.1.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dompurify": "^3.4.17",
    "dotenv": "^18.0.10",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.4",
    "express-session": "^1.19.0",
    "helmet": "^8.3.0",
    "i18next": "^27.1.1",
    "imapflow": "^2.11.0",
    "multer": "^2.5.0",
    "node-pop3": "^0.15.4",
    "nodemailer": "^10.5.0",
    "postal-mime": "^4.2.1",
    "reflect-metadata": "^0.2.2",
    "tar": "^7.5.23",
    "undici": "^8.12.4",
    "uuid": "^14.0.3"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^5.1.0",
    "happy-dom": "^21.0.4",
    "jsdom": "^31.0.1",
    "nw": "^0.120.0-sdk",
    "nw-builder": "^4.25.0",
    "supertest": "^7.3.2",
    "vitest": "^5.1.0"
  },
  "allowScripts": {
    "nw-builder@4.25.0": true,
    "better-sqlite3@13.1.1": true,
    "nw@0.120.0-sdk": true
  },
  "overrides": {
    "@nwutils/getter": "0.2.8"
  }
}
